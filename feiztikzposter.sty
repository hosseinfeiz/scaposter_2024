% =================================================================
%  feiztikzposter.sty   ––  FEIZ TikZposter house style
%  2025-05-04  (revised)
% =================================================================
\ProvidesPackage{feiztikzposter}[2025/05/04 FEIZ TikZposter Style]

% -----------------------------------------------------------------
%  Base dependencies — **FIXED**
% -----------------------------------------------------------------
% Load the *core* TikZposter class, not this style file again.
\RequirePackage{feiztikzposter}
\RequirePackage{xcolor}
\RequirePackage{xkeyval}
\RequirePackage{ifthen}

\makeatletter

% -----------------------------------------------------------------
%  Key lengths
% -----------------------------------------------------------------
\newlength{\feiztikzposter@logoheight}
\newlength{\feiztikzposter@logorightmargin}
\newlength{\feiztikzposter@bannerheight}
\newlength{\feiztikzposter@margin}
\newlength{\feiztikzposter@titleinnersep}

% Landscape / portrait–dependent defaults
\ifthenelse{\lengthtest{\paperwidth > \paperheight}}{% landscape
  \setlength{\feiztikzposter@logoheight}{3.45cm}
  \setlength{\feiztikzposter@logorightmargin}{1.15cm}
  \setlength{\feiztikzposter@bannerheight}{13.27cm}
}{% portrait
  \setlength{\feiztikzposter@logoheight}{3.5cm}
  \setlength{\feiztikzposter@logorightmargin}{2.15cm}
  \setlength{\feiztikzposter@bannerheight}{15.23cm}
}
\setlength{\feiztikzposter@margin}{1.5cm}
\setlength{\feiztikzposter@titleinnersep}{1.5cm}

% -----------------------------------------------------------------
%  Allow use of \title, \author, \institute if desired — **FIXED**
% -----------------------------------------------------------------
\settitle{%
  % use the *local* inner‑sep length defined above                        
  \vspace*{-\feiztikzposter@titleinnersep}%
  \vspace*{\TP@innermargin}%
  \hspace*{-\feiztikzposter@titleinnersep}%
  \hspace*{\TP@innermargin}%
  {\color{titlefgcolor}%
    \begin{minipage}{\titlewidth - 2\TP@innermargin}%
      {\bfseries\Huge\@title\par}%
      \begin{minipage}{\titlewidth - \feiztikzposter@logorightmargin - 4.15\feiztikzposter@logoheight - 2\TP@innermargin}%
        \vspace*{\feiztikzposter@titleinnersep}%
        \huge\@author\par
        \vspace*{\feiztikzposter@titleinnersep}%
        \large\@institute
      \end{minipage}%
    \end{minipage}}}

% -----------------------------------------------------------------
%  FEIZ colour palette (CMYK)
% -----------------------------------------------------------------
\definecolor{feizDarkBlue}{cmyk}{1,0.5,0,0.3}
\definecolor{feizWhite}{cmyk}{0,0,0,0}
\definecolor{feizVibrantPink}{cmyk}{0.24,0.99,0.31,0.15}
\definecolor{feizVibrantPurple}{cmyk}{0,0.3,1,0.3}
\definecolor{feizDarkYellow}{cmyk}{0.59,0.51,0.54,0.50}
\definecolor{feizMutedGreen}{cmyk}{0.3,0,0.3,0}
\definecolor{feizVibrantGreen}{cmyk}{0.62,0,0.83,0}

% -----------------------------------------------------------------
%  Base colour style (inherits Default then overrides)
% -----------------------------------------------------------------
\usecolorstyle{Default}

% Custom colour style used by FEIZ blocks
\definecolorstyle{feizDarkYellow}{%
  \definecolor{colorOne}{named}{feizDarkYellow}
  \definecolor{colorTwo}{named}{feizWhite}
  \definecolor{colorThree}{named}{feizVibrantPink}
}{%
  \colorlet{backgroundcolor}{colorTwo}
  \colorlet{framecolor}{colorTwo}
  \colorlet{titlefgcolor}{colorTwo}
  \colorlet{titlebgcolor}{colorOne}
  \colorlet{blocktitlebgcolor}{colorOne}
  \colorlet{blocktitlefgcolor}{colorTwo}
  \colorlet{blockbodybgcolor}{feizWhite}
  \colorlet{blockbodyfgcolor}{black}
  \colorlet{innerblocktitlebgcolor}{colorThree}
  \colorlet{innerblocktitlefgcolor}{feizWhite}
  \colorlet{innerblockbodybgcolor}{feizWhite}
  \colorlet{innerblockbodyfgcolor}{black}
  \colorlet{notefgcolor}{feizWhite}
  \colorlet{notebgcolor}{colorThree}
  \colorlet{notefrcolor}{colorThree}
}
\usecolorstyle{feizDarkYellow}

% -----------------------------------------------------------------
%  Title style
% -----------------------------------------------------------------
\definetitlestyle{feiz}{%
  width=\paperwidth,
  linewidth=10pt,
  innersep=\feiztikzposter@titleinnersep,
  titletotopverticalspace=0mm,
  titletoblockverticalspace=\feiztikzposter@margin
}{%
  \tikzset{
    x=\feiztikzposter@logoheight,
    y=\feiztikzposter@logoheight,
    banner/.style={fill=titlebgcolor},
    portico/.style={fill=titlefgcolor}}
  \newcommand{\rightmarginfeiz}{\feiztikzposter@logorightmargin}
  \begin{scope}[shift={(\titleposright-\rightmarginfeiz,\titleposbottom)}]
  \end{scope}
}
\usetitlestyle{feiz}

% -----------------------------------------------------------------
%  Block styles
% -----------------------------------------------------------------
% -- Main FEIZ block ------------------------------------------------
\defineblockstyle{feiz}{%
  titlewidthscale=1,bodywidthscale=1,titleleft,
  titleoffsetx=0pt,titleoffsety=0pt,
  bodyoffsetx=0pt,bodyoffsety=0pt,
  bodyverticalshift=0pt,roundedcorners=2pt,
  linewidth=0.1cm,titleinnersep=0.5cm,bodyinnersep=1cm
}{%
  \begin{scope}[line width=\blocklinewidth,rounded corners=\blockroundedcorners]
    \ifBlockHasTitle
      \draw[color=feizDarkBlue,fill=feizDarkBlue]
        (blockbody.south west) rectangle (blocktitle.north east);
      \draw[color=feizDarkBlue,fill=blockbodybgcolor]
        (blockbody.south west) rectangle (blockbody.north east);
    \else
      \draw[color=feizDarkBlue,fill=blockbodybgcolor]
        (blockbody.south west) rectangle (blockbody.north east);
    \fi
  \end{scope}
}

% -- Alternative red block -----------------------------------------
\defineblockstyle{blockred}{%
  titlewidthscale=1,bodywidthscale=1,titleleft,
  titleoffsetx=0pt,titleoffsety=0pt,
  bodyoffsetx=0pt,bodyoffsety=0pt,
  bodyverticalshift=0pt,roundedcorners=2pt,
  linewidth=0.1cm,titleinnersep=0.5cm,bodyinnersep=1cm
}{%
  \begin{scope}[line width=\blocklinewidth,rounded corners=\blockroundedcorners]
    \ifBlockHasTitle
      \draw[color=feizVibrantPurple,fill=feizVibrantPurple]
        (blockbody.south west) rectangle (blocktitle.north east);
      \draw[color=feizVibrantPurple,fill=blockbodybgcolor]
        (blockbody.south west) rectangle (blockbody.north east);
    \else
      \draw[color=feizVibrantPurple,fill=blockbodybgcolor]
        (blockbody.south west) rectangle (blockbody.north east);
    \fi
  \end{scope}
}

% -----------------------------------------------------------------
%  Inner‑block styles
% -----------------------------------------------------------------
\defineinnerblockstyle{feiz}{%
  titlewidthscale=1,bodywidthscale=1,titleleft,
  titleoffsetx=0pt,titleoffsety=0pt,
  bodyoffsetx=0pt,bodyoffsety=0pt,
  bodyverticalshift=0pt,roundedcorners=5,
  linewidth=4pt,titleinnersep=10pt,bodyinnersep=12pt
}{%
  \begin{scope}[line width=\innerblocklinewidth,rounded corners=\innerblockroundedcorners]
    \ifInnerblockHasTitle
      \draw[color=feizMutedGreen,fill=feizMutedGreen]
        (innerblockbody.south west) rectangle (innerblocktitle.north east);
      \draw[color=feizMutedGreen,fill=innerblockbodybgcolor]
        (innerblockbody.south west) rectangle (innerblockbody.north east);
    \else
      \draw[color=feizMutedGreen,fill=innerblockbodybgcolor]
        (innerblockbody.south west) rectangle (innerblockbody.north east);
    \fi
  \end{scope}
}

\defineinnerblockstyle{greeninnerblock}{%
  titlewidthscale=1,bodywidthscale=1,titleleft,
  titleoffsetx=0pt,titleoffsety=0pt,
  bodyoffsetx=0pt,bodyoffsety=0pt,
  bodyverticalshift=0pt,roundedcorners=5,
  linewidth=4pt,titleinnersep=10pt,bodyinnersep=12pt
}{%
  \begin{scope}[line width=\innerblocklinewidth,rounded corners=\innerblockroundedcorners]
    \ifInnerblockHasTitle
      \draw[color=feizVibrantGreen,fill=feizVibrantGreen]
        (innerblockbody.south west) rectangle (innerblocktitle.north east);
      \draw[color=feizVibrantGreen,fill=innerblockbodybgcolor]
        (innerblockbody.south west) rectangle (innerblockbody.north east);
    \else
      \draw[color=feizVibrantGreen,fill=innerblockbodybgcolor]
        (innerblockbody.south west) rectangle (innerblockbody.north east);
    \fi
  \end{scope}
}

% -----------------------------------------------------------------
%  Activate the styles globally
% -----------------------------------------------------------------
\useblockstyle{feiz}
\useinnerblockstyle{feiz}

% -----------------------------------------------------------------
%  Remove default “Made with TikZposter” footer
% -----------------------------------------------------------------
\tikzposterlatexaffectionproofoff

\makeatother
